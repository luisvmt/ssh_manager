{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SSH Manager (terminal integrado)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/sshmanager.dll",
      "args": ["--parameters", "${workspaceFolder}/parameters.conf"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "SSH Manager (terminal externo)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/sshmanager.dll",
      "args": ["--parameters", "${workspaceFolder}/parameters.conf"],
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false
    }
  ]
}
